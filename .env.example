# FraudGraph Investigator — Environment Variables
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# ── TigerGraph Connection ──────────────────────────────────────────────────────
# Full URL to your TigerGraph Savanna instance (no trailing slash)
TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io

# TigerGraph credentials
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password_here

# Graph name (must match the graph created in TigerGraph Studio)
TIGERGRAPH_GRAPH_NAME=FraudGraph

# API secret — generate from TigerGraph Admin Panel → User Management → Secrets
TIGERGRAPH_SECRET=your_secret_here

# ── MCP Server ────────────────────────────────────────────────────────────────
# Port for the MCP server to listen on
MCP_PORT=8765

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to directory containing the CSV dataset files
# Default is the workspace root (current directory)
DATA_DIR=./

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
