// FraudGraph Loading Jobs — TigerGraph 3.x / 4.x
// Run after schema deployment.
// CSV files are generated by scripts/generate_graph_load_files.py
// and placed in data/graph_load/
//
// Usage:
//   gsql -g FraudGraph tigergraph/loading/loading.gsql
//   gsql -g FraudGraph "RUN LOADING JOB load_all_vertices"
//   gsql -g FraudGraph "RUN LOADING JOB load_all_edges"

USE GRAPH FraudGraph

// ── Vertex Loading Jobs ────────────────────────────────────────────────────

CREATE LOADING JOB load_customers FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX Customer VALUES (
        $"customer_id",
        $"first_seen",
        $"last_seen"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_cards FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX Card VALUES (
        $"card_id",
        $"card4",
        $"card6",
        $"card1"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_transactions FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX Transaction VALUES (
        $"TransactionID",
        $"TransactionDT",
        $"TransactionAmt",
        $"ProductCD",
        $"card4",
        $"card6",
        $"channel",
        $"risk_score",
        $"ts",
        $"P_emaildomain",
        $"R_emaildomain",
        $"addr1",
        $"addr2",
        $"C1",
        $"C2",
        $"D1",
        $"M1",
        $"M2",
        $"M3"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_device_profiles FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX DeviceProfile VALUES (
        $"device_id",
        $"DeviceType",
        $"DeviceInfo",
        $"os",
        $"browser"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_regions FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX Region VALUES (
        $"region_code"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_email_domains FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX EmailDomain VALUES (
        $"domain"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_closed_cases FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX ClosedCase VALUES (
        $"case_id",
        $"outcome",
        $"pattern",
        $"opened_at",
        $"closed_at",
        $"exposure_usd",
        $"n_txns",
        $"actions_taken",
        $"analyst_notes"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_investigation_cases FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX InvestigationCase VALUES (
        $"case_id",
        $"opened_at",
        $"trigger_type",
        $"trigger_text",
        $"risk_score"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_fraud_patterns FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    LOAD f1 TO VERTEX FraudPattern VALUES (
        $"pattern_name",
        $"description"
    ) USING header="true", separator=",";
}

// ── Edge Loading Jobs ──────────────────────────────────────────────────────

CREATE LOADING JOB load_owns_edges FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    // customer_id, card_id
    LOAD f1 TO EDGE OWNS VALUES (
        $"customer_id",
        $"card_id"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_performed_edges FOR GRAPH FraudGraph {
    DEFINE FILENAME f1;
    // customer_id, TransactionID
    LOAD f1 TO EDGE PERFORMED VALUES (
        $"customer_id",
        $"TransactionID"
    ) USING header="true", separator=",";
}

CREATE LOADING JOB load_made_edges FOR GRAPH FraudGraph {
